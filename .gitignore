# =============================================================================
# RedlineRAG .gitignore
# Standard Python + uv + IDE ignores. Drop in at the project root.
# =============================================================================

# --- Python build / runtime ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# --- Virtual environments (uv, venv, poetry, conda) ---------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- uv cache (project-local caches, regenerate on demand) -------------------
.uv-cache/

# --- Test / coverage artifacts -----------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/
.tox/

# --- Type / linter caches -----------------------------------------------------
.mypy_cache/
.ruff_cache/
.pyright_cache/

# --- OS noise -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Editor noise -------------------------------------------------------------
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
*.swp
*.swo
*~

# --- Runtime data (regenerable, user-private) --------------------------------
# The vector store is rebuilt from source documents on every `scan --rebuild`.
data/vector_store/
# Real user ToS files dropped into data/raw/ are presumed private. The
# auto-generated mock corpus is regenerated by MockTosGenerator on first
# run, so we exclude it from version control too.
data/raw/*
!data/raw/.gitkeep
# EXCEPTION: test_trap_agreement.txt is a fixed test fixture, not user
# input. The auditor test suite and manual smoke runs depend on it being
# there. If you drop a real ToS into data/raw/ the gitignore still keeps
# your file private.
!data/raw/test_trap_agreement.txt
data/mock/
# Generic catch-all: any *.txt dropped directly into data/ (not data/raw/
# or data/vector_store/) is almost certainly a one-off output from a
# manual run, not source. Keep the repo clean.
/data/*.txt

# --- Logs (the rule: never exceed 1 GB; always clean) --------------------------
*.log
*.log.*
logs/
